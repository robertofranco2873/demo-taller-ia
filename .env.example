# Copia este archivo como .env y pega tu key gratuita de https://console.groq.com/keys
# Sin key, la app funciona completa; solo se ocultan las funciones de IA.
GROQ_API_KEY=
# Opcional: modelo de Groq (alternativa: openai/gpt-oss-120b). Lista: https://console.groq.com/docs/models
GROQ_MODEL=qwen/qwen3.8-27b
# Opcional: secreto para firmar los JWT (si falta, se genera uno al arrancar y las sesiones
# se invalidan al reiniciar). En Render se genera automáticamente.
JWT_SECRET=
# Opcional: ruta de la base SQLite (p. ej. un disco persistente).
# TALLER_DB_PATH=data/taller.db
